      "id": "160f6343-5f93-5c4d-b6cb-45850fb2ff2d",
      "name": "Buat Draf Material Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
