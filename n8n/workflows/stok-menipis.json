    {
      "parameters": {
        "url": "={{ $env.ERPNEXT_URL }}/api/resource/Material%20Request",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "[\"name\",\"status\",\"items.item_code\",\"items.warehouse\"]"
            },
            {
              "name": "filters",
              "value": "[[\"docstatus\",\"<\",2],[\"material_request_type\",\"=\",\"Purchase\"],[\"status\",\"not in\",[\"Stopped\",\"Cancelled\",\"Received\",\"Transferred\",\"Issued\",\"Manufactured\"]]]"
            },
            {
              "name": "limit_page_length",
              "value": "0"
            }
          ]
        }
      },
      "id": "0ede9d76-5fe1-5def-8232-3d20a2f29306",
      "name": "MR Belum Selesai",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bjmErpNextAuth01",
          "name": "ERPNext n8n-bot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const items = $('Detail Item').all().map((i) => i.json.data);\nconst bins = $('Stok per Gudang').first().json.data;\nconst open = $('MR Belum Selesai').first().json.data;\n\nconst key = (item, warehouse) => `${item}|${warehouse}`;\nconst projected = new Map(bins.map((b) => [key(b.item_code, b.warehouse), b.projected_qty]));\nconst pending = new Set(open.map((r) => key(r.item_code, r.warehouse)));\n\nconst rows = [];\nlet company;\nfor (const item of items) {\n  for (const r of item.reorder_levels ?? []) {\n    if (r.material_request_type !== 'Purchase') continue;\n    const level = r.warehouse_reorder_level;\n    let qty = r.warehouse_reorder_qty;\n    if (!level && !qty) continue;\n    // Belum pernah ada transaksi = tidak ada baris Bin = stok 0.\n    const stock = projected.get(key(item.name, r.warehouse)) ?? 0;\n    if (stock > level || pending.has(key(item.name, r.warehouse))) continue;\n    // Sama seperti ERPNext: pesanan harus cukup untuk mengembalikan stok ke atas batas.\n    if (stock + qty <= level) qty += level - stock;\n    if (qty <= 0) continue;\n    company ??= item.item_defaults?.[0]?.company;\n    rows.push({\n      item_code: item.name, item_name: item.item_name, warehouse: r.warehouse,\n      uom: item.stock_uom, stock, level, qty,\n    });\n  }\n}\n\n// Tidak ada yang perlu dipesan: alur berhenti di sini, tanpa dokumen dan tanpa pesan.\nif (!rows.length) return [];\n\nconst today = $now.toFormat('yyyy-MM-dd');\nconst needBy = $now.plus({ days: 7 }).toFormat('yyyy-MM-dd');\nconst body = {\n  material_request_type: 'Purchase',\n  company,\n  transaction_date: today,\n  schedule_date: needBy,\n  items: rows.map((r) => ({\n    item_code: r.item_code, qty: r.qty, warehouse: r.warehouse, schedule_date: needBy,\n    uom: r.uom, stock_uom: r.uom, conversion_factor: 1,\n  })),\n};\nreturn [{ json: { body, rows } }];"
      },
      "id": "6e4d8374-1fc4-51a5-b6eb-b19a050699b1",
