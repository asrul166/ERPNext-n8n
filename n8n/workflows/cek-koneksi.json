{
  "id": "bjmCekKoneksi001",
  "name": "BJM - Cek Koneksi",
  "nodes": [
    {
      "parameters": {},
      "id": "f012ca4c-bfca-5c82-a8a9-3279926a4096",
      "name": "Jalankan Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.ERPNEXT_URL }}/api/resource/Item",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "[\"name\",\"item_name\"]"
            },
            {
              "name": "limit_page_length",
              "value": "5"
            }
          ]
        }
      },
      "id": "59e65181-b8de-5b28-93cb-38019f7a899f",
      "name": "Daftar Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bjmErpNextAuth01",
          "name": "ERPNext n8n-bot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst lines = $input.first().json.data.map((i) => `• ${esc(i.item_name)} (${esc(i.name)})`);\nreturn [{ json: { text: ['<b>Tes koneksi n8n → ERPNext</b>', ...lines].join('\\n') } }];"
      },
      "id": "1dea8168-0567-54a3-9dfa-78fae4098966",
      "name": "Susun Pesan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "id": "babce542-d20e-5135-8376-682e27c56215",
      "name": "Kirim Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "bjmTelegramBot01",
          "name": "Telegram BJM"
        }
      }
    }
  ],
  "connections": {
