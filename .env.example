# Salin menjadi .env lalu isi. File .env TIDAK boleh di-commit.
# `node seed/init-env.mjs` membuat .env dengan password acak secara otomatis.

# --- ERPNext ---
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=
ERPNEXT_PORT=8081
ERPNEXT_PUBLIC_URL=http://localhost:8081

# --- API key user n8n-bot (diisi otomatis oleh seed) ---
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# --- n8n ---
N8N_PORT=5678
N8N_ENCRYPTION_KEY=

# --- Telegram (diisi manual) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opsional; kosong berarti memakai TELEGRAM_CHAT_ID.
TELEGRAM_FINANCE_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=

# --- Email pengingat. Bawaan: Mailpit (kotak uji lokal, tidak ada email keluar). ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=keuangan@bjm.example.com
MAILPIT_PORT=8025
